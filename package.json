{
  "name": "aws-codebuild-status",
  "displayName": "AWS Build & Compute Status",
  "description": "View AWS CodeBuild and EC2 instance status in a regional tree using your local AWS CLI.",
  "version": "0.3.0",
  "publisher": "baebranch",
  "author": {
    "name": "Brian Branch"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/baebranch/aws-codebuild-status#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/baebranch/aws-codebuild-status.git"
  },
  "bugs": {
    "url": "https://github.com/baebranch/aws-codebuild-status/issues"
  },
  "keywords": [
    "aws",
    "codebuild",
    "ec2",
    "ci",
    "build",
    "instance",
    "status"
  ],
  "galleryBanner": {
    "color": "#0d1526",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "awsCodeBuild",
          "title": "AWS Build & Compute",
          "icon": "media/codebuild.svg"
        }
      ]
    },
    "views": {
      "awsCodeBuild": [
        {
          "id": "awsCodeBuild.buildsView",
          "name": "Resources",
          "icon": "media/codebuild.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "awsCodeBuild.refresh",
        "title": "Refresh",
        "category": "AWS Build & Compute",
        "icon": "$(refresh)"
      },
      {
        "command": "awsCodeBuild.refreshItem",
        "title": "Refresh",
        "category": "AWS Build & Compute",
        "icon": "$(refresh)"
      },
      {
        "command": "awsCodeBuild.loadMore",
        "title": "Load More",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.startBuild",
        "title": "Start Build",
        "category": "AWS Build & Compute",
        "icon": "$(play)"
      },
      {
        "command": "awsCodeBuild.openInConsole",
        "title": "Open in AWS Console",
        "category": "AWS Build & Compute",
        "icon": "$(link-external)"
      },
      {
        "command": "awsCodeBuild.openLogs",
        "title": "View Build Logs",
        "category": "AWS Build & Compute",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "awsCodeBuild.refresh",
          "when": "view == awsCodeBuild.buildsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == region",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == codeBuildSection",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == instancesSection",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == project",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == instance",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.startBuild",
          "when": "view == awsCodeBuild.buildsView && viewItem == project",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.openLogs",
          "when": "view == awsCodeBuild.buildsView && viewItem == build",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.openInConsole",
          "when": "view == awsCodeBuild.buildsView && viewItem == build"
        }
      ]
    },
    "configuration": {
      "title": "AWS Build & Compute Status",
      "properties": {
        "awsCodeBuild.regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "AWS regions to query for CodeBuild projects and EC2 instances. If empty, the default region from your AWS CLI configuration is used."
        },
        "awsCodeBuild.profile": {
          "type": "string",
          "default": "",
          "description": "AWS CLI named profile to use. If empty, the default profile / environment credentials are used."
        },
        "awsCodeBuild.pageSize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of CodeBuild runs to load per page, per project."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "typescript": "^5.4.0"
  }
}
