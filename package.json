{
  "name": "aws-codebuild-status",
  "displayName": "AWS Build & Compute Status",
  "description": "View AWS CodeBuild builds, EC2 instances, EBS volumes and snapshots, ECR images, and Elastic IPs in a regional tree using your local AWS CLI.",
  "version": "0.5.0",
  "publisher": "baebranch",
  "author": {
    "name": "Brian Branch"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/baebranch/aws-codebuild-status#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/baebranch/aws-codebuild-status.git"
  },
  "bugs": {
    "url": "https://github.com/baebranch/aws-codebuild-status/issues"
  },
  "keywords": [
    "aws",
    "codebuild",
    "ec2",
    "ebs",
    "ecr",
    "elastic ip",
    "ci",
    "build",
    "instance",
    "status"
  ],
  "galleryBanner": {
    "color": "#0d1526",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "awsCodeBuild",
          "title": "AWS Build & Compute",
          "icon": "media/codebuild.svg"
        }
      ]
    },
    "views": {
      "awsCodeBuild": [
        {
          "id": "awsCodeBuild.buildsView",
          "name": "Resources",
          "icon": "media/codebuild.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "awsCodeBuild.refresh",
        "title": "Refresh",
        "category": "AWS Build & Compute",
        "icon": "$(refresh)"
      },
      {
        "command": "awsCodeBuild.refreshItem",
        "title": "Refresh",
        "category": "AWS Build & Compute",
        "icon": "$(refresh)"
      },
      {
        "command": "awsCodeBuild.loadMore",
        "title": "Load More",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.startBuild",
        "title": "Start Build",
        "category": "AWS Build & Compute",
        "icon": "$(play)"
      },
      {
        "command": "awsCodeBuild.openInConsole",
        "title": "Open in AWS Console",
        "category": "AWS Build & Compute",
        "icon": "$(link-external)"
      },
      {
        "command": "awsCodeBuild.selectProfile",
        "title": "Select AWS Profile",
        "category": "AWS Build & Compute",
        "icon": "$(account)"
      },
      {
        "command": "awsCodeBuild.openInstanceInConsole",
        "title": "Open Instance in AWS Console",
        "category": "AWS Build & Compute",
        "icon": "$(link-external)"
      },
      {
        "command": "awsCodeBuild.copyInstanceId",
        "title": "Copy Instance ID",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copySnapshotId",
        "title": "Copy Snapshot ID",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copySnapshotVolumeId",
        "title": "Copy Source Volume ID",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.copyRepositoryUri",
        "title": "Copy Repository URI",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copyImageUri",
        "title": "Copy Image URI",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copyImageDigest",
        "title": "Copy Image Digest",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.copyPublicIp",
        "title": "Copy Public IP",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copyAllocationId",
        "title": "Copy Allocation ID",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.copyAddressTargetId",
        "title": "Copy Attached Instance / ENI ID",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.hideTerminated",
        "title": "Hide Terminated Instances",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.showTerminated",
        "title": "Show Terminated Instances",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.copyVolumeId",
        "title": "Copy Volume ID",
        "category": "AWS Build & Compute",
        "icon": "$(copy)"
      },
      {
        "command": "awsCodeBuild.copyVolumeInstanceId",
        "title": "Copy Attached Instance ID",
        "category": "AWS Build & Compute"
      },
      {
        "command": "awsCodeBuild.openLogs",
        "title": "View Build Logs",
        "category": "AWS Build & Compute",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "awsCodeBuild.selectProfile",
          "when": "view == awsCodeBuild.buildsView",
          "group": "navigation@0"
        },
        {
          "command": "awsCodeBuild.refresh",
          "when": "view == awsCodeBuild.buildsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == region",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == codeBuildSection",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem =~ /^instancesSection/",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.hideTerminated",
          "when": "view == awsCodeBuild.buildsView && viewItem == instancesSection",
          "group": "1_filter"
        },
        {
          "command": "awsCodeBuild.showTerminated",
          "when": "view == awsCodeBuild.buildsView && viewItem == instancesSection.hidingTerminated",
          "group": "1_filter"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == volumesSection",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.copyVolumeId",
          "when": "view == awsCodeBuild.buildsView && viewItem =~ /^volume(Attached)?$/",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == resourceSection",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == repository",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.copySnapshotId",
          "when": "view == awsCodeBuild.buildsView && viewItem == snapshot",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.copySnapshotId",
          "when": "view == awsCodeBuild.buildsView && viewItem == snapshot",
          "group": "1_copy@1"
        },
        {
          "command": "awsCodeBuild.copySnapshotVolumeId",
          "when": "view == awsCodeBuild.buildsView && viewItem == snapshot",
          "group": "1_copy@2"
        },
        {
          "command": "awsCodeBuild.copyRepositoryUri",
          "when": "view == awsCodeBuild.buildsView && viewItem == repository",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.copyRepositoryUri",
          "when": "view == awsCodeBuild.buildsView && viewItem == repository",
          "group": "1_copy@1"
        },
        {
          "command": "awsCodeBuild.copyImageUri",
          "when": "view == awsCodeBuild.buildsView && viewItem == image",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.copyImageUri",
          "when": "view == awsCodeBuild.buildsView && viewItem == image",
          "group": "1_copy@1"
        },
        {
          "command": "awsCodeBuild.copyImageDigest",
          "when": "view == awsCodeBuild.buildsView && viewItem == image",
          "group": "1_copy@2"
        },
        {
          "command": "awsCodeBuild.copyPublicIp",
          "when": "view == awsCodeBuild.buildsView && viewItem =~ /^address(Attached)?$/",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.copyPublicIp",
          "when": "view == awsCodeBuild.buildsView && viewItem =~ /^address(Attached)?$/",
          "group": "1_copy@1"
        },
        {
          "command": "awsCodeBuild.copyAllocationId",
          "when": "view == awsCodeBuild.buildsView && viewItem =~ /^address(Attached)?$/",
          "group": "1_copy@2"
        },
        {
          "command": "awsCodeBuild.copyAddressTargetId",
          "when": "view == awsCodeBuild.buildsView && viewItem == addressAttached",
          "group": "1_copy@3"
        },
        {
          "command": "awsCodeBuild.copyVolumeInstanceId",
          "when": "view == awsCodeBuild.buildsView && viewItem == volumeAttached",
          "group": "1_volume@2"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == project",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.refreshItem",
          "when": "view == awsCodeBuild.buildsView && viewItem == instance",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.openInstanceInConsole",
          "when": "view == awsCodeBuild.buildsView && viewItem == instance",
          "group": "1_instance@1"
        },
        {
          "command": "awsCodeBuild.copyInstanceId",
          "when": "view == awsCodeBuild.buildsView && viewItem == instance",
          "group": "1_instance@2"
        },
        {
          "command": "awsCodeBuild.startBuild",
          "when": "view == awsCodeBuild.buildsView && viewItem == project",
          "group": "navigation"
        },
        {
          "command": "awsCodeBuild.openLogs",
          "when": "view == awsCodeBuild.buildsView && viewItem == build",
          "group": "inline"
        },
        {
          "command": "awsCodeBuild.openInConsole",
          "when": "view == awsCodeBuild.buildsView && viewItem == build"
        }
      ]
    },
    "configuration": {
      "title": "AWS Build & Compute Status",
      "properties": {
        "awsCodeBuild.regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "AWS regions to query for CodeBuild, EC2, EBS, ECR, and Elastic IP resources. If empty, the default region from your AWS CLI configuration is used."
        },
        "awsCodeBuild.profile": {
          "type": "string",
          "default": "",
          "description": "AWS CLI named profile to use. If empty, the default profile / environment credentials are used. The profile picker saves this per workspace when a folder is open."
        },
        "awsCodeBuild.pageSize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of CodeBuild runs to load per page, per project."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "publish:ovsx:vsix": "node scripts/publish-ovsx-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "typescript": "^5.4.0"
  }
}
